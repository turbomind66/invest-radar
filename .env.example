# 复制为 .env 后按需修改：cp .env.example .env

# ---- 端口（已固定，通常不用改）----
# 网关在容器内监听 38881；宿主机映射 **0.0.0.0:48881**（v2.4.2 起，
# 让 NPM 等容器化反代经 Docker 网桥 172.17.0.1 也能访问）。
# 公网不直连 48881：仍由防火墙只放行 22/80/443，实际流量走 NPM → 443 回源。
# 裸机部署（不用 Docker）时直接跑 `python gateway.py --port 48881`。
GATEWAY_HOST_PORT=48881
GATEWAY_PORT=38881

# 两个看板的内部端口（只在容器网络内使用，不对外映射，别改）
PORT=5000
QDII_PORT=5001

# ---- 时区（务必保持北京时间，调度与交易日判定都依赖它）----
TZ=Asia/Shanghai

# ---- 调度时间点（北京时间，逗号分隔）----
# 完整同步：收盘后抓当日 + 次日清晨重刷前一日（对齐 GitHub Actions 的 17:00 / 06:00）
SCHED_FULL_TIMES=06:00,17:10
# 盘中逐笔大单采样：东财明细是滚动窗口、盘后冻结，必须盘中多次采样才累积得到
SCHED_TICK_TIMES=09:30,10:00,10:30,11:00,11:30,13:00,13:30,14:00,14:30,14:50
# 启动即跑一次完整同步（首次部署为空库时，会自动从内置种子恢复 90 天历史）
SCHED_RUN_ON_START=1
# 周末不跑全量同步（1=跳过周六周日）
SCHED_FULL_WEEKDAY_ONLY=1
# 单次任务超时（秒），超时自动终止，避免卡住堆积
SCHED_TIMEOUT=1800

# ---- 展示实例是否自行抓取 ----
# Compose 模式固定为 0（web 只展示，抓取由 cron 容器负责）；
# 单容器模式（./deploy.sh --run）请保持 1，否则不会自动更新数据。
NT_AUTO_ENSURE=1

# ============================================================
# QDII 海外基金定投决策面板（同一入口 /qdii/，独立 DB）
# 容器服务：qdii-web（看板 + /api/qdii/*） / qdii-cron（双日历调度）
# ============================================================

# ---- QDII 双日历调度时间点（均为北京时间，容器已设 TZ=Asia/Shanghai）----
# 限额/申购状态 + 多平台费率 + 跟踪误差（按 A 股交易日）
QDII_SCHED_LIMITTIMES=09:00
# 美股信号（期货/现货昨收/VIX/美债，按美股交易日）
# 注：北京时间 14:30 = 美东约 01:30-02:30，美股现货已收盘取昨收，期货近 24h 实时
QDII_SCHED_SIGNALTIME=14:30
# 场内溢价率（按 A 股交易日，14:30 处于 A 股交易时段，场内价为实时）
QDII_SCHED_PREMIUMTIME=14:30

# ---- 页头「面板选项卡」互跳地址 ----
# 走 gateway 单端口入口时，两个面板在同一域名的 / 与 /qdii/ 下，直接写相对路径即可。
# （选项卡原本按「本端口 ±1」推断，走网关/反代后端口推断会失效 → 显式指定最稳。）
# 独立子域名部署时改写成完整 URL，例如 https://qdii.你的域名
PEER_URL=/qdii/
QDII_PEER_URL=/nt/

# ---- 站点路径前缀（一般留空）----
# 正常走 gateway 时由网关剥前缀，这里保持空。
# 只有绕过网关、让 NPM 直接代理到 5000/5001 且**保留**前缀时才需要填（BASE_PATH=/nt、QDII_BASE_PATH=/qdii）。
BASE_PATH=
QDII_BASE_PATH=
