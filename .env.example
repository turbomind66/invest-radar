# 复制为 .env 后按需修改：cp .env.example .env

# ---- 端口 ----
# 宿主机映射端口（改成服务器上未被占用的端口）
HOST_PORT=18080
# 容器内监听端口
PORT=5000

# ---- 时区（务必保持北京时间，调度与交易日判定都依赖它）----
TZ=Asia/Shanghai

# ---- 调度时间点（北京时间，逗号分隔）----
# 完整同步：收盘后抓当日 + 次日清晨重刷前一日（对齐 GitHub Actions 的 17:00 / 06:00）
SCHED_FULL_TIMES=06:00,17:10
# 盘中逐笔大单采样：东财明细是滚动窗口、盘后冻结，必须盘中多次采样才累积得到
SCHED_TICK_TIMES=10:30,11:30,14:00,14:50
# 启动即跑一次完整同步（首次部署为空库时，会自动从内置种子恢复 90 天历史）
SCHED_RUN_ON_START=1
# 周末不跑全量同步（1=跳过周六周日）
SCHED_FULL_WEEKDAY_ONLY=1
# 单次任务超时（秒），超时自动终止，避免卡住堆积
SCHED_TIMEOUT=1800

# ---- 展示实例是否自行抓取 ----
# Compose 模式固定为 0（web 只展示，抓取由 cron 容器负责）；
# 单容器模式（./deploy.sh --run）请保持 1，否则不会自动更新数据。
NT_AUTO_ENSURE=1

# ============================================================
# QDII 海外基金定投决策面板（独立端口/DB，与 tracker 共存）
# 容器服务：qdii-web（看板 + /api/qdii/*） / qdii-cron（双日历调度）
# ============================================================
# QDII Web 容器内监听端口（与 tracker 的 5000 区分）
QDII_PORT=5001
# 宿主机映射端口（避免与 tracker 的 18080 冲突）
QDII_HOST_PORT=18081

# ---- QDII 双日历调度时间点（均为北京时间，容器已设 TZ=Asia/Shanghai）----
# 限额/申购状态 + 多平台费率 + 跟踪误差（按 A 股交易日）
QDII_SCHED_LIMITTIMES=09:00
# 美股信号（期货/现货昨收/VIX/美债，按美股交易日）
# 注：北京时间 14:30 = 美东约 01:30-02:30，美股现货已收盘取昨收，期货近 24h 实时
QDII_SCHED_SIGNALTIME=14:30
# 场内溢价率（按 A 股交易日，14:30 处于 A 股交易时段，场内价为实时）
QDII_SCHED_PREMIUMTIME=14:30

# ---- 页头「面板选项卡」互跳地址（域名反代部署时必填）----
# 说明：选项卡互跳原本按「本端口 ±1」推断（5000↔5001）。
# 用 Nginx / NPM 按域名反代后，两个面板的端口都是 443，端口推断会指向不存在的端口 → 死链。
# 两种写法都可：
#   · 同域不同路径（推荐，一个域名两个面板）：写相对路径 /qdii/ 、/nt/
#   · 独立子域名：写完整 URL https://qdii.你的域名
# 留空则回退到端口推断（适合本机不同端口直接访问的场景）。
# 国家队看板 → QDII 面板
PEER_URL=/qdii/
# QDII 面板 → 国家队看板
QDII_PEER_URL=/nt/

# ---- 站点路径前缀（可选）----
# 仅当 NPM 反代时「保留前缀不剥」才需要填（页面已自动按当前路径拼接口地址，
# 服务端靠它把 /nt/api/data 剥回 /api/data）。NPM 若用 Forward Path 去前缀则留空。
BASE_PATH=
QDII_BASE_PATH=
